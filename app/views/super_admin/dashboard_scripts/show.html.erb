          scriptExists = true;
          existingScriptElement = scriptEl;
        }
      });
      
      if (scriptExists && existingScriptElement) {
        // Atualizar script existente
        existingScriptElement.querySelector('.script-content').value = uiThemeScript;
        existingScriptElement.querySelector('.script-name').value = 'ui-theme-button-colors';
        existingScriptElement.querySelector('.script-active').checked = true;
        existingScriptElement.classList.remove('opacity-50');
