        <textarea id="change-page-title-script" style="display: none;"><script data-name="change-page-title">
(function () {
  const MODULE_KEY = "StackLab_ChangePageTitle_v1";
  if (window[MODULE_KEY]) return;
  window[MODULE_KEY] = true;

  const PAGE_TITLE = "{{PAGE_TITLE}}";

  if (!PAGE_TITLE || PAGE_TITLE === "{{PAGE_TITLE}}") {
    return;
  }

  function changeTitle() {
    document.title = PAGE_TITLE;
  }

  // primeira passada
  changeTitle();

  // observar mudanças no título (caso seja alterado dinamicamente)
  const titleObserver = new MutationObserver(() => {
    if (document.title !== PAGE_TITLE) {
      changeTitle();
    }
  });
  
  const titleElement = document.querySelector('title');
  if (titleElement) {
    titleObserver.observe(titleElement, { childList: true, characterData: true, subtree: true });
  }

  // observar mudanças no head (caso o title seja recriado)
  const headObserver = new MutationObserver(() => {
    if (document.title !== PAGE_TITLE) {
      changeTitle();
    }
  });
  headObserver.observe(document.head, { childList: true, subtree: true });

  // reforço em delays
  [100, 400, 1000].forEach(ms => setTimeout(changeTitle, ms));
})();
</script></textarea>
        <textarea id="change-og-seo-script" style="display: none;"><script data-name="change-og-seo">
(function () {
  const MODULE_KEY = "StackLab_ChangeOGSEO_v1";
  if (window[MODULE_KEY]) return;
  window[MODULE_KEY] = true;

  const OG_TITLE = "{{OG_TITLE}}";
  const OG_DESCRIPTION = "{{OG_DESCRIPTION}}";
  const OG_IMAGE = "{{OG_IMAGE}}";

  if ((!OG_TITLE || OG_TITLE === "{{OG_TITLE}}") && (!OG_DESCRIPTION || OG_DESCRIPTION === "{{OG_DESCRIPTION}}") && (!OG_IMAGE || OG_IMAGE === "{{OG_IMAGE}}")) {
    return;
  }

  function getOrCreateMetaTag(property) {
    let meta = document.querySelector(`meta[property="${property}"]`);
    if (!meta) {
      meta = document.createElement('meta');
      meta.setAttribute('property', property);
      document.head.appendChild(meta);
    }
    return meta;
  }

  function updateOGTags() {
    if (OG_TITLE && OG_TITLE !== "{{OG_TITLE}}") {
      const ogTitle = getOrCreateMetaTag('og:title');
      ogTitle.setAttribute('content', OG_TITLE);
    }

    if (OG_DESCRIPTION && OG_DESCRIPTION !== "{{OG_DESCRIPTION}}") {
      const ogDescription = getOrCreateMetaTag('og:description');
      ogDescription.setAttribute('content', OG_DESCRIPTION);
    }

    if (OG_IMAGE && OG_IMAGE !== "{{OG_IMAGE}}") {
      const ogImage = getOrCreateMetaTag('og:image');
      ogImage.setAttribute('content', OG_IMAGE);
    }
  }

  // primeira passada
  updateOGTags();

  // observar mudanças no head (caso as meta tags sejam recriadas)
  const headObserver = new MutationObserver(() => {
    updateOGTags();
  });
  headObserver.observe(document.head, { childList: true, subtree: true });

  // reforço em delays
  [100, 400, 1000].forEach(ms => setTimeout(updateOGTags, ms));
})();
</script></textarea>
        <textarea id="login-pro-script" style="display: none;"><script data-name="login-pro">
(function () {
  const MODULE_KEY = "StackLab_LoginPro_v1";
  if (window[MODULE_KEY]) return;
  window[MODULE_KEY] = true;

  const LOGIN_IMAGE_URL = "{{LOGIN_IMAGE_URL}}";

  if (!LOGIN_IMAGE_URL || LOGIN_IMAGE_URL === "{{LOGIN_IMAGE_URL}}") {
    return;
  }

  function isLoginPage() {
    return window.location.pathname.includes('/app/login');
  }

  function applyLoginPro() {
    if (!isLoginPage()) return;

    const main = document.querySelector('main.flex.flex-col');
    if (!main) return;

    // Verificar se já foi aplicado
    if (main.hasAttribute('data-login-pro-applied')) return;
    main.setAttribute('data-login-pro-applied', 'true');

    // Criar estilo
    let style = document.getElementById('login-pro-style');
    if (!style) {
      style = document.createElement('style');
      style.id = 'login-pro-style';
      document.head.appendChild(style);
    }

    style.innerHTML = `
      main[data-login-pro-applied] .login-pro-right {
        display: none !important;
      }
      @media (min-width: 1024px) {
        main[data-login-pro-applied] {
          flex-direction: row !important;
          min-height: 100vh !important;
          height: 100vh !important;
          padding: 0 !important;
        }
        main[data-login-pro-applied] .login-pro-left {
          flex: 0 0 50% !important;
          max-width: 50% !important;
          display: flex !important;
          flex-direction: column !important;
          padding: 5rem 1.5rem !important;
          overflow-y: auto !important;
        }
        main[data-login-pro-applied] .login-pro-right {
          flex: 0 0 50% !important;
          max-width: 50% !important;
          display: flex !important;
          padding: 0 !important;
          height: 100vh !important;
        }
        main[data-login-pro-applied] .login-pro-right .login-pro-image-wrapper {
          width: 100% !important;
          height: 100% !important;
          display: flex !important;
          align-items: center !important;
          justify-content: center !important;
          background-color: white !important;
          border-radius: 0 !important;
          box-shadow: none !important;
        }
        main[data-login-pro-applied] .login-pro-image {
          width: 100% !important;
          height: 100% !important;
          object-fit: cover !important;
        }
      }
    `;

    // Envolver as seções existentes em um container
    const sections = Array.from(main.querySelectorAll('section'));
    if (sections.length === 0) return;

    // Criar wrapper para o lado esquerdo
    const leftWrapper = document.createElement('div');
    leftWrapper.className = 'login-pro-left';
    
    // Mover todas as seções existentes para o wrapper
    sections.forEach(section => {
      leftWrapper.appendChild(section);
    });

    // Adicionar o wrapper de volta ao main
    main.appendChild(leftWrapper);

    // Criar container para imagem (lado direito)
    const rightContainer = document.createElement('div');
    rightContainer.className = 'login-pro-right';
    const imageWrapper = document.createElement('div');
    imageWrapper.className = 'login-pro-image-wrapper';
    const img = document.createElement('img');
    img.src = LOGIN_IMAGE_URL;
    img.alt = 'Login';
    img.className = 'login-pro-image';
    imageWrapper.appendChild(img);
    rightContainer.appendChild(imageWrapper);

    // Adicionar a imagem como último elemento do main
    main.appendChild(rightContainer);
  }

  // Aplicar quando DOM estiver pronto
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', applyLoginPro);
  } else {
    applyLoginPro();
  }

  // Observer para mudanças no DOM
  const mo = new MutationObserver(() => {
    if (isLoginPage()) {
      const main = document.querySelector('main.flex.flex-col');
      if (main && !main.hasAttribute('data-login-pro-applied')) {
        applyLoginPro();
      }
    }
  });
  mo.observe(document.body, { childList: true, subtree: true });

  // Reforço em delays
  [100, 400, 1000, 2000].forEach(ms => setTimeout(applyLoginPro, ms));
})();
</script></textarea>
