  // Função para converter hex para RGB
  function hexToRgb(hex) {
    const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
    return result ? {
      r: parseInt(result[1], 16),
      g: parseInt(result[2], 16),
      b: parseInt(result[3], 16)
    } : null;
  }

  // Função para gerar cores derivadas
  function generateColorVariations(baseColor) {
    const rgb = hexToRgb(baseColor);
    if (!rgb) return { base: baseColor, hover: baseColor, dark: baseColor, darkHover: baseColor, light: baseColor, lightText: baseColor, backgroundLight: `rgba(91, 63, 196, 0.05)` };
    
    // Hover (mais claro)
    const hover = `#${Math.min(255, Math.floor(rgb.r * 1.4)).toString(16).padStart(2, '0')}${Math.min(255, Math.floor(rgb.g * 1.4)).toString(16).padStart(2, '0')}${Math.min(255, Math.floor(rgb.b * 1.4)).toString(16).padStart(2, '0')}`;
    
    // Dark mode (mais escuro)
    const dark = `#${Math.max(0, Math.floor(rgb.r * 0.3)).toString(16).padStart(2, '0')}${Math.max(0, Math.floor(rgb.g * 0.3)).toString(16).padStart(2, '0')}${Math.max(0, Math.floor(rgb.b * 0.3)).toString(16).padStart(2, '0')}`;
    
    // Dark hover
    const darkHover = `#${Math.min(255, Math.floor(rgb.r * 0.5)).toString(16).padStart(2, '0')}${Math.min(255, Math.floor(rgb.g * 0.5)).toString(16).padStart(2, '0')}${Math.min(255, Math.floor(rgb.b * 0.5)).toString(16).padStart(2, '0')}`;
    
    // Light background (10% opacity)
    const light = `#${Math.min(255, Math.floor(rgb.r * 0.1 + 240)).toString(16).padStart(2, '0')}${Math.min(255, Math.floor(rgb.g * 0.1 + 240)).toString(16).padStart(2, '0')}${Math.min(255, Math.floor(rgb.b * 0.1 + 240)).toString(16).padStart(2, '0')}`;
    
    // Light text (mais claro para contraste)
    const lightText = `#${Math.min(255, Math.floor(rgb.r * 0.7 + 200)).toString(16).padStart(2, '0')}${Math.min(255, Math.floor(rgb.g * 0.7 + 200)).toString(16).padStart(2, '0')}${Math.min(255, Math.floor(rgb.b * 0.7 + 200)).toString(16).padStart(2, '0')}`;
    
    // Background light (5% opacity) para login page
    const backgroundLight = `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, 0.05)`;
    
    return { base: baseColor, hover, dark, darkHover, light, lightText, backgroundLight };
  }

  // Função para recuperar cor do script existente
  function recoverColorFromScript() {
    const colorPicker = document.getElementById('color-picker');
    if (!colorPicker) return;
    
    // Verificar nos scripts já carregados na página
    const existingScripts = document.querySelectorAll('.script-item');
    for (let i = 0; i < existingScripts.length; i++) {
      const scriptEl = existingScripts[i];
      const scriptContent = scriptEl.querySelector('.script-content').value;
      if (scriptContent && scriptContent.includes('data-name="ui-theme-button-colors"')) {
        // Extrair a primeira cor hexadecimal do script (cor base)
        const colorMatch = scriptContent.match(/background-color:\s*(#[0-9A-Fa-f]{6})/);
        if (colorMatch && colorMatch[1]) {
          colorPicker.value = colorMatch[1];
          return;
        }
      }
    }
    
    // Se não encontrou nos scripts carregados, verificar no script existente do servidor
    const existingScriptsData = <%= raw @dashboard_scripts.to_json %>;
    if (existingScriptsData && existingScriptsData.includes('data-name="ui-theme-button-colors"')) {
      const colorMatch = existingScriptsData.match(/background-color:\s*(#[0-9A-Fa-f]{6})/);
      if (colorMatch && colorMatch[1]) {
        colorPicker.value = colorMatch[1];
      }
    }
  }

  // Botão "Definir Cor" na aba White Label Pro
  const definirCorBtn = document.getElementById('definir-cor-btn');
  if (definirCorBtn) {
    definirCorBtn.addEventListener('click', function() {
      const colorPicker = document.getElementById('color-picker');
      const selectedColor = colorPicker ? colorPicker.value : '#5B3FC4';
      const colors = generateColorVariations(selectedColor);
      
      const uiThemeScriptEl = document.getElementById('ui-theme-button-script');
      let uiThemeScript = uiThemeScriptEl ? uiThemeScriptEl.value.trim() : '';
      
      if (!uiThemeScript) {
        alert('Script não encontrado');
        return;
      }
      
      // Substituir cores no script
      uiThemeScript = uiThemeScript
        .replace(/#5B3FC4/g, colors.base)
        .replace(/#8A6CF0/g, colors.hover)
        .replace(/#24134D/g, colors.dark)
        .replace(/#36206F/g, colors.darkHover)
        .replace(/#EFEAFB/g, colors.light)
        .replace(/#C9B7FF/g, colors.lightText)
        .replace(/#2F225A/g, colors.dark)
        .replace(/rgba\(91,\s*63,\s*196,\s*0\.05\)/g, colors.backgroundLight);
      
      // Verificar se já existe um script com o mesmo data-name
      const existingScripts = document.querySelectorAll('.script-item');
      let scriptExists = false;
      let existingScriptElement = null;
      
      existingScripts.forEach(scriptEl => {
