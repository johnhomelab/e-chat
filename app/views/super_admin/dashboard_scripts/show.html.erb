  // Função para mostrar/esconder o popover
  function togglePopover() {
    const isHidden = addScriptPopover.classList.contains('hidden');
    if (isHidden) {
      // Calcular posição do botão
      const buttonRect = addScriptBtn.getBoundingClientRect();
      const popoverHeight = 120; // Altura aproximada do popover

      // Posicionar o popover abaixo do botão (alinhado à esquerda)
      addScriptPopover.style.top = (buttonRect.bottom + 8) + 'px';
      addScriptPopover.style.left = (buttonRect.left) + 'px';

      // Mostrar o popover
      addScriptPopover.classList.remove('hidden');
      addScriptPopover.style.opacity = '1';
      addScriptPopover.style.transform = 'translateY(0)';

      // Fechar o popover quando clicar fora dele
      document.addEventListener('click', closePopoverOnOutsideClick);
    } else {
      // Esconder o popover
      addScriptPopover.style.opacity = '0';
      addScriptPopover.style.transform = 'translateY(-5px)';
      setTimeout(() => {
        addScriptPopover.classList.add('hidden');
