  const logoHorizontalDarkInput = document.getElementById('logo-horizontal-dark-input');
  const logoHorizontalDarkPreview = document.getElementById('logo-horizontal-dark-preview');
  const logoHorizontalDarkPreviewPlaceholder = document.getElementById('logo-horizontal-dark-preview-placeholder');
  
  // Função para atualizar preview do logotipo horizontal dark
  function updateHorizontalDarkLogoPreview(url) {
    if (!logoHorizontalDarkPreview || !logoHorizontalDarkPreviewPlaceholder) return;
    
    if (url && url.trim()) {
      try {
        // Validar URL
        new URL(url);
        logoHorizontalDarkPreview.src = url;
        logoHorizontalDarkPreview.style.display = 'block';
        logoHorizontalDarkPreviewPlaceholder.style.display = 'none';
      } catch (e) {
        logoHorizontalDarkPreview.style.display = 'none';
        logoHorizontalDarkPreviewPlaceholder.style.display = 'block';
        logoHorizontalDarkPreviewPlaceholder.textContent = 'URL inválida';
      }
    } else {
      logoHorizontalDarkPreview.style.display = 'none';
      logoHorizontalDarkPreviewPlaceholder.style.display = 'block';
      logoHorizontalDarkPreviewPlaceholder.textContent = 'Nenhuma imagem';
    }
  }
  
  // Event listener para atualizar preview em tempo real
  if (logoHorizontalDarkInput) {
    logoHorizontalDarkInput.addEventListener('input', function() {
      updateHorizontalDarkLogoPreview(this.value);
    });
    
    // Tratar erro de carregamento da imagem
    if (logoHorizontalDarkPreview) {
      logoHorizontalDarkPreview.addEventListener('error', function() {
        this.style.display = 'none';
        if (logoHorizontalDarkPreviewPlaceholder) {
          logoHorizontalDarkPreviewPlaceholder.style.display = 'block';
          logoHorizontalDarkPreviewPlaceholder.textContent = 'Erro ao carregar imagem';
        }
      });
    }
  }
  
  if (aplicarLogoHorizontalDarkBtn && logoHorizontalDarkInput) {
    // Função para recuperar URL do logotipo horizontal dark do script existente
    function recoverLogoHorizontalDarkUrlFromScript() {
      const existingScripts = document.querySelectorAll('.script-item');
      for (let i = 0; i < existingScripts.length; i++) {
        const scriptEl = existingScripts[i];
        const scriptContent = scriptEl.querySelector('.script-content').value;
        if (scriptContent && scriptContent.includes('data-name="change-logo-horizontal-dark"')) {
          // Extrair a URL do logotipo horizontal dark do script
          const urlMatch = scriptContent.match(/const LOGO_URL = "([^"]+)"/);
          if (urlMatch && urlMatch[1]) {
            logoHorizontalDarkInput.value = urlMatch[1];
            updateHorizontalDarkLogoPreview(urlMatch[1]);
            return;
          }
        }
      }
      
      // Se não encontrou nos scripts carregados, verificar no script existente do servidor
      const existingScriptsData = <%= raw @dashboard_scripts.to_json %>;
      if (existingScriptsData && existingScriptsData.includes('data-name="change-logo-horizontal-dark"')) {
        const urlMatch = existingScriptsData.match(/const LOGO_URL = "([^"]+)"/);
        if (urlMatch && urlMatch[1]) {
          logoHorizontalDarkInput.value = urlMatch[1];
          updateHorizontalDarkLogoPreview(urlMatch[1]);
        }
      }
    }

    // Recuperar URL quando abrir a aba White Label Pro
    document.querySelectorAll('div[data-tab]').forEach(div => {
      div.addEventListener('click', function() {
        const tabName = this.dataset.tab;
        if (tabName === 'white-label-pro') {
          setTimeout(recoverLogoHorizontalDarkUrlFromScript, 100);
        }
      });
    });

    // Event listener para o botão
    aplicarLogoHorizontalDarkBtn.addEventListener('click', function() {
      const logoUrl = logoHorizontalDarkInput.value.trim();
      
      // Verificar se já existe um script com o mesmo data-name
      const existingScripts = document.querySelectorAll('.script-item');
      let scriptExists = false;
      let existingScriptElement = null;
      
      existingScripts.forEach(scriptEl => {
        const scriptContent = scriptEl.querySelector('.script-content').value;
        if (scriptContent && scriptContent.includes('data-name="change-logo-horizontal-dark"')) {
          scriptExists = true;
          existingScriptElement = scriptEl;
        }
      });

      // Se o input estiver vazio, remover o script
      if (!logoUrl) {
        if (scriptExists && existingScriptElement) {
          existingScriptElement.remove();
          updateCombinedScripts();
          document.querySelector('div[data-tab="editor"]').click();
          const combinedScriptsField = document.getElementById('combined-scripts');
          if (combinedScriptsField) {
            const editorForm = combinedScriptsField.closest('form');
            if (editorForm) {
              editorForm.submit();
            }
          }
        }
        return;
      }

      // Validar URL básica
      try {
        new URL(logoUrl);
      } catch (e) {
        alert('Por favor, insira uma URL válida (ex: https://exemplo.com/logo-dark.svg)');
        return;
      }

      const changeLogoHorizontalDarkScriptEl = document.getElementById('change-logo-horizontal-dark-script');
      let changeLogoHorizontalDarkScript = changeLogoHorizontalDarkScriptEl ? changeLogoHorizontalDarkScriptEl.value.trim() : '';
      
      if (!changeLogoHorizontalDarkScript) {
        alert('Script não encontrado');
        return;
      }
      
      // Substituir o placeholder pela URL real
      changeLogoHorizontalDarkScript = changeLogoHorizontalDarkScript.replace('{{LOGO_URL}}', logoUrl);
      
      if (scriptExists && existingScriptElement) {
        // Atualizar script existente
        existingScriptElement.querySelector('.script-content').value = changeLogoHorizontalDarkScript;
        existingScriptElement.querySelector('.script-name').value = 'change-logo-horizontal-dark';
        existingScriptElement.querySelector('.script-active').checked = true;
        existingScriptElement.classList.remove('opacity-50');
      } else {
        // Adicionar novo script
        addScript(changeLogoHorizontalDarkScript, 'change-logo-horizontal-dark', 'function', true);
      }
      
      // Atualizar o campo combined-scripts
      updateCombinedScripts();
      
      // Mudar para a aba Editor
      document.querySelector('div[data-tab="editor"]').click();
      
      // Submeter o formulário da aba Editor
      const combinedScriptsField = document.getElementById('combined-scripts');
      if (combinedScriptsField) {
        const editorForm = combinedScriptsField.closest('form');
        if (editorForm) {
          editorForm.submit();
        }
      }
    });
  }

  // Botão "Aplicar" para Logout Redirect na aba White Label Pro
  const aplicarLogoutRedirectBtn = document.getElementById('aplicar-logout-redirect-btn');
  const logoutRedirectInput = document.getElementById('logout-redirect-input');
  
  if (aplicarLogoutRedirectBtn && logoutRedirectInput) {
    // Carregar valor atual
    const currentLogoutRedirect = <%= raw @logout_redirect_link.to_json %>;
    if (currentLogoutRedirect) {
      logoutRedirectInput.value = currentLogoutRedirect;
    }

    // Event listener para o botão
    aplicarLogoutRedirectBtn.addEventListener('click', function() {
      const logoutRedirectLink = logoutRedirectInput.value.trim() || '/app/login';
      
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = '<%= update_logout_redirect_super_admin_dashboard_scripts_path %>';
      
      const tokenInput = document.createElement('input');
      tokenInput.type = 'hidden';
      tokenInput.name = 'authenticity_token';
      tokenInput.value = document.querySelector('meta[name="csrf-token"]').content;
      form.appendChild(tokenInput);
      
      const linkInput = document.createElement('input');
      linkInput.type = 'hidden';
      linkInput.name = 'logout_redirect_link';
      linkInput.value = logoutRedirectLink;
      form.appendChild(linkInput);
      
      document.body.appendChild(form);
      form.submit();
    });
  }

  // Checkbox "Login Pro" na aba White Label Pro
  const loginProCheckbox = document.getElementById('login-pro-checkbox');
  const loginProInputContainer = document.getElementById('login-pro-input-container');
  const loginProImageInput = document.getElementById('login-pro-image-input');
  const loginProPreview = document.getElementById('login-pro-preview');
  const loginProPreviewPlaceholder = document.getElementById('login-pro-preview-placeholder');
  const aplicarLoginProBtn = document.getElementById('aplicar-login-pro-btn');

  // Função para atualizar preview da imagem do login pro
  function updateLoginProPreview(url) {
    if (!loginProPreview || !loginProPreviewPlaceholder) return;
    
    if (url && url.trim()) {
      try {
        new URL(url);
        loginProPreview.src = url;
        loginProPreview.style.display = 'block';
        loginProPreviewPlaceholder.style.display = 'none';
      } catch (e) {
        loginProPreview.style.display = 'none';
        loginProPreviewPlaceholder.style.display = 'block';
        loginProPreviewPlaceholder.textContent = 'URL inválida';
      }
    } else {
      loginProPreview.style.display = 'none';
      loginProPreviewPlaceholder.style.display = 'block';
      loginProPreviewPlaceholder.textContent = 'Nenhuma imagem';
    }
  }

  // Event listener para atualizar preview em tempo real
  if (loginProImageInput) {
    loginProImageInput.addEventListener('input', function() {
      updateLoginProPreview(this.value);
    });
    
    if (loginProPreview) {
      loginProPreview.addEventListener('error', function() {
        this.style.display = 'none';
        if (loginProPreviewPlaceholder) {
          loginProPreviewPlaceholder.style.display = 'block';
          loginProPreviewPlaceholder.textContent = 'Erro ao carregar imagem';
        }
      });
    }
  }

  // Função para verificar se o script já existe e marcar o checkbox
  function checkIfLoginProScriptExists() {
    const existingScripts = document.querySelectorAll('.script-item');
    let scriptExists = false;
    
    existingScripts.forEach(scriptEl => {
      const scriptContent = scriptEl.querySelector('.script-content').value;
      if (scriptContent && scriptContent.includes('data-name="login-pro"')) {
        scriptExists = true;
      }
    });
    
    const existingScriptsData = <%= raw @dashboard_scripts.to_json %>;
    if (existingScriptsData && existingScriptsData.includes('data-name="login-pro"')) {
      scriptExists = true;
    }
    
    if (loginProCheckbox) {
      loginProCheckbox.checked = scriptExists;
      if (scriptExists && loginProInputContainer) {
        loginProInputContainer.classList.remove('hidden');
      }
    }
    
    // Recuperar URL se o script existir
    if (scriptExists && loginProImageInput) {
      const existingScripts = document.querySelectorAll('.script-item');
      for (let i = 0; i < existingScripts.length; i++) {
        const scriptEl = existingScripts[i];
        const scriptContent = scriptEl.querySelector('.script-content').value;
        if (scriptContent && scriptContent.includes('data-name="login-pro"')) {
          const urlMatch = scriptContent.match(/const LOGIN_IMAGE_URL = "([^"]+)"/);
          if (urlMatch && urlMatch[1]) {
            loginProImageInput.value = urlMatch[1];
            updateLoginProPreview(urlMatch[1]);
            return;
          }
        }
      }
      
      const existingScriptsData = <%= raw @dashboard_scripts.to_json %>;
      if (existingScriptsData && existingScriptsData.includes('data-name="login-pro"')) {
        const urlMatch = existingScriptsData.match(/const LOGIN_IMAGE_URL = "([^"]+)"/);
        if (urlMatch && urlMatch[1]) {
          loginProImageInput.value = urlMatch[1];
          updateLoginProPreview(urlMatch[1]);
        }
      }
    }
  }

  // Verificar ao carregar a página
  setTimeout(checkIfLoginProScriptExists, 200);

  // Event listener para o checkbox
  if (loginProCheckbox && loginProInputContainer) {
    loginProCheckbox.addEventListener('change', function() {
      if (this.checked) {
        loginProInputContainer.classList.remove('hidden');
      } else {
        loginProInputContainer.classList.add('hidden');
        // Remover script se desmarcar
        const existingScripts = document.querySelectorAll('.script-item');
        let existingScriptElement = null;
        
        existingScripts.forEach(scriptEl => {
          const scriptContent = scriptEl.querySelector('.script-content').value;
          if (scriptContent && scriptContent.includes('data-name="login-pro"')) {
            existingScriptElement = scriptEl;
          }
        });

        if (existingScriptElement) {
          existingScriptElement.remove();
          updateCombinedScripts();
          document.querySelector('div[data-tab="editor"]').click();
          const combinedScriptsField = document.getElementById('combined-scripts');
          if (combinedScriptsField) {
            const editorForm = combinedScriptsField.closest('form');
            if (editorForm) {
              editorForm.submit();
            }
          }
        }
      }
    });
  }

  // Event listener para o botão "Aplicar"
  if (aplicarLoginProBtn && loginProImageInput) {
    aplicarLoginProBtn.addEventListener('click', function() {
      const imageUrl = loginProImageInput.value.trim();
      
      if (!imageUrl) {
        alert('Por favor, insira uma URL de imagem');
        return;
      }

      // Validar URL básica
      try {
        new URL(imageUrl);
      } catch (e) {
        alert('Por favor, insira uma URL válida (ex: https://exemplo.com/imagem.jpg)');
        return;
      }

      const loginProScriptEl = document.getElementById('login-pro-script');
      let loginProScript = loginProScriptEl ? loginProScriptEl.value.trim() : '';
      
      if (!loginProScript) {
        alert('Script não encontrado');
        return;
      }
      
      // Substituir o placeholder pela URL real
      loginProScript = loginProScript.replace('{{LOGIN_IMAGE_URL}}', imageUrl);
      
      // Verificar se já existe um script com o mesmo data-name
      const existingScripts = document.querySelectorAll('.script-item');
      let scriptExists = false;
      let existingScriptElement = null;
      
      existingScripts.forEach(scriptEl => {
        const scriptContent = scriptEl.querySelector('.script-content').value;
        if (scriptContent && scriptContent.includes('data-name="login-pro"')) {
          scriptExists = true;
          existingScriptElement = scriptEl;
        }
      });

      if (scriptExists && existingScriptElement) {
        // Atualizar script existente
        existingScriptElement.querySelector('.script-content').value = loginProScript;
        existingScriptElement.querySelector('.script-name').value = 'login-pro';
        existingScriptElement.querySelector('.script-active').checked = true;
        existingScriptElement.classList.remove('opacity-50');
      } else {
        // Adicionar novo script
        addScript(loginProScript, 'login-pro', 'function', true);
      }
      
      // Atualizar o campo combined-scripts
      updateCombinedScripts();
      
      // Mudar para a aba Editor
      document.querySelector('div[data-tab="editor"]').click();
      
      // Submeter o formulário da aba Editor
      const combinedScriptsField = document.getElementById('combined-scripts');
      if (combinedScriptsField) {
        const editorForm = combinedScriptsField.closest('form');
        if (editorForm) {
          editorForm.submit();
        }
      }
    });
  }

  // Recuperar URL quando abrir a aba White Label Pro
  document.querySelectorAll('div[data-tab]').forEach(div => {
    div.addEventListener('click', function() {
      const tabName = this.dataset.tab;
      if (tabName === 'white-label-pro') {
        setTimeout(checkIfLoginProScriptExists, 100);
      }
    });
  });
  
  // Inicializar com um script vazio ou com o script existente
  const existingScripts = <%= raw @dashboard_scripts.to_json %>;
  if (existingScripts) {
    // Verificar se contém um ou mais HTMLs completos
    const hasCompleteHTML = /<(!DOCTYPE|html|body)[\s>]/i.test(existingScripts);
    
    if (hasCompleteHTML) {
      // Verificar se existem múltiplos documentos HTML
      const htmlDocs = existingScripts.split(/<!DOCTYPE/i).filter(part => part.trim());
      
      if (htmlDocs.length > 1) {
        // Temos múltiplos documentos HTML
        htmlDocs.forEach((doc, index) => {
          // Adicionar DOCTYPE de volta se não for o primeiro fragmento
          const fullDoc = index > 0 ? '<!DOCTYPE' + doc : doc;
          
          // Extrair o data-name
          let htmlName = `HTML Completo ${index + 1}`;
          const dataNameMatch = fullDoc.match(/data-name="([^"]+)"/);
          if (dataNameMatch && dataNameMatch[1]) {
            htmlName = dataNameMatch[1];
          }
          
          // Adicionar como um script separado
          addScript(fullDoc, htmlName, 'component');
        });
      } else {
        // Um único HTML completo
        let htmlName = 'HTML Completo';
        const dataNameMatch = existingScripts.match(/data-name="([^"]+)"/);
        if (dataNameMatch && dataNameMatch[1]) {
          htmlName = dataNameMatch[1];
        }
        
        // Se for HTML completo, manter como um único script
        addScript(existingScripts, htmlName, 'component');
      }
    } else {
      // Tenta dividir o script existente em múltiplos scripts
      const scriptParts = existingScripts.split(/(<script[\s\S]*?<\/script>)/gi)
        .filter(part => part.trim().startsWith('<script'));
      
      if (scriptParts.length > 0) {
        scriptParts.forEach((part, index) => {
          // Tenta extrair o nome do atributo data-name
          const nameMatch = part.match(/data-name="([^"]+)"/);
          const scriptName = nameMatch ? nameMatch[1] : `Script ${index + 1}`;
          
          
          // Verifica se o script está ativo
          const isActiveMatch = part.match(/data-active="false"/);
          const isActive = !isActiveMatch;
          
          // Adiciona o script com o status correto de ativação
          addScript(part, scriptName, 'function', isActive);
        });
      }
    }
  } else {
    // Se não existir nenhum script, adiciona um vazio
    addScript();
  }
  
  // Recuperar cor do script existente após os scripts serem carregados
  setTimeout(recoverColorFromScript, 100);
});
</script>

<script>
// Listener para receber script importado da galeria
window.addEventListener('message', function(event) {
  if (event.data && event.data.type === 'IMPORT_SCRIPT') {
    const script = event.data.script;
    const name = event.data.name;
    
    // Verificar se a função addScript está disponível
    if (typeof addScript === 'function') {
      addScript(script, name);
      
      // Mudar para a aba do editor
      document.querySelector('div[data-tab="editor"]').click();
      
      // Mostrar mensagem de confirmação
      const notification = document.createElement('div');
      notification.className = 'fixed top-4 right-4 bg-green-50 text-green-700 p-4 rounded-md shadow-md z-50';
      notification.innerHTML = `<p><strong>Script importado:</strong> ${name}</p>`;
      document.body.appendChild(notification);
      
      setTimeout(function() {
        notification.remove();
      }, 3000);
    } else {
      console.error('Função addScript não está disponível');
    }
  }
});
</script>

