<% content_for(:title) do %>
  Modulos StackLab
<% end %>

<style>
.toggle-icon {
  transition: transform 0.2s ease;
}

.toggle-icon.expanded svg {
  transform: rotate(180deg);
}

/* Estilos para o popover */
#add-script-popover {
  box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
}

</style>

<header class="main-content__header" role="banner">
  <div class="flex justify-between items-center w-full">
    <h1 class="main-content__page-title" id="page-title">
      <%= content_for(:title) %>
    </h1>
    <div class="flex items-center ml-auto">
      <a href="https://github.com/StackLab-Digital/StackLabModulos" target="_blank" class="flex items-center space-x-2 text-gray-600 hover:text-gray-800 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-github-icon lucide-github">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
          <path d="M9 18c-4.51 2-5-2-7-2"/>
        </svg>
        <span class="text-sm font-medium">GitHub</span>
      </a>
    </div>
  </div>
</header>

<section class="main-content__body">
  <div class="tabs" id="script-tabs">
    <%= render 'tabs' %>

    <div class="bg-blue-50 border rounded-lg p-4 mb-6 mt-4" style="border-color: rgba(156, 163, 175, 0.3);">
      <div class="flex items-start">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-blue-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-blue-800">
            Como funcionam os Módulos StackLab?
          </h3>
          <div class="mt-2 text-sm text-blue-700">
            <p>
              Saiba mais sobre como os módulos personalizam seu Chatwoot através de scripts seguros e desacoplados.
              <a href="https://app.stacklab.digital/hc/portal/articles/1754580828-o-que-sao-os-modulos-stack_lab" target="_blank" class="font-medium underline hover:text-blue-600 transition-colors">
                Leia o artigo completo na Central de Ajuda →
              </a>
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="tab-content active" data-tab-content="editor">
      <div class="mb-6">
      </div>

      <%= form_with url: super_admin_dashboard_scripts_path, method: :post do |form| %>
        <div class="flex justify-between items-center mb-4">
          <h3 class="font-medium">Lista de Scripts</h3>
          <div class="flex items-center space-x-2 relative">
            <button type="button" id="add-script-btn" style="display: inline-block; background-color: black; color: white; padding: 8px 16px; border-radius: 8px;">
              + Adicionar Script
            </button>
            <%= form.submit "Salvar Scripts", style: "display: inline-block; background-color: black; color: white; padding: 8px 16px; border-radius: 8px;" %>
          </div>
        </div>

        <!-- Popover para seleção de tipo de script -->
        <div id="add-script-popover" class="fixed z-50 w-64 bg-white border border-gray-200 rounded-lg shadow-lg hidden" style="transform: translateY(-5px); opacity: 0; transition: all 0.15s ease-out;">
          <div class="p-2">
            <button type="button" id="create-blank-script" style="display: inline-block; background-color: black; color: white; padding: 8px 16px; border-radius: 8px; border: none; width: 100%; margin-bottom: 8px; cursor: pointer;" class="flex items-center justify-center hover:opacity-80 transition-opacity">
              <span class="text-sm font-medium">Criar em Branco</span>
            </button>
            <button type="button" id="create-stacklab-script" style="display: inline-block; background-color: black; color: white; padding: 8px 16px; border-radius: 8px; border: none; width: 100%; cursor: pointer;" class="flex items-center justify-center hover:opacity-80 transition-opacity">
              <span class="text-sm font-medium">Usar StackLab IA</span>
            </button>
          </div>
        </div>

        <div id="scripts-container" class="space-y-4">
          <!-- Scripts serão adicionados aqui dinamicamente -->
        </div>
        
        <%= form.hidden_field :dashboard_scripts, id: 'combined-scripts' %>


      <% end %>
    </div>
    
    <div class="tab-content hidden" data-tab-content="preview">
      <div class="p-3 border rounded-md">
        <div class="flex flex-col">
          <div class="flex justify-between items-center mb-2">
            <h3 class="text-sm font-medium">Preview do Script Combinado</h3>
            <button type="button" id="run-preview" style="display: inline-block; background-color: black; color: white; padding: 8px 16px; border-radius: 8px;">Executar Preview</button>
          </div>
          <div class="mb-3">
          <select id="script-selector" class="border rounded-md px-2 py-1 w-full">
              <option value="">Visualizar script individual...</option>
            <!-- Scripts serão adicionados aqui dinamicamente -->
          </select>
        </div>
          </div>
        <div id="preview-container" class="p-3 bg-slate-50 rounded-md min-h-[300px] overflow-auto">
          <div class="text-center text-slate-400">
            Clique em "Executar Preview" para testar o script
            </div>
          </div>
        </div>
      </div>
      
      <div class="tab-content hidden" data-tab-content="help">
        <div class="p-3 border rounded-md space-y-4">
          <div>
            <h3 class="text-sm font-medium mb-2">O que são Modulos StackLab?</h3>
            <p class="text-sm text-slate-600">
              Modulos StackLab são snippets de HTML/JavaScript que são injetados no final da tag &lt;body&gt; em todas as páginas do dashboard do Chatwoot. 
              Eles permitem personalizar a aparência e funcionalidade do Chatwoot sem modificar o código-fonte.
            </p>
          </div>
          
          <div>
            <h3 class="text-sm font-medium mb-2">Dicas de Segurança</h3>
            <ul class="list-disc pl-5 text-sm text-slate-600 space-y-1">
              <li>Sempre envolva seu código em uma verificação DOMContentLoaded para garantir que o DOM esteja carregado</li>
              <li>Evite scripts que bloqueiam a renderização da página</li>
              <li>Teste seus scripts em um ambiente não-produtivo antes de aplicar</li>
              <li>Use seletores CSS específicos para evitar conflitos</li>
              <li>Não use para injetar scripts de terceiros não confiáveis</li>
            </ul>
          </div>
          
          <div>
            <h3 class="text-sm font-medium mb-2">Casos de Uso Comuns</h3>
            <ul class="list-disc pl-5 text-sm text-slate-600 space-y-1">
              <li>Personalização de cores e estilos</li>
              <li>Adição de funcionalidades customizadas</li>
              <li>Integração com ferramentas de analytics</li>
              <li>Criar atalhos de teclado personalizados</li>
              <li>Melhorar a acessibilidade</li>
            </ul>
          </div>
        </div>
      </div>
      
      <div class="tab-content hidden" data-tab-content="white-label-pro">
        <textarea id="ui-theme-button-script" style="display: none;"><script data-name="ui-theme-button-colors">
document.addEventListener('DOMContentLoaded', function () {

  function isTargetAccount() {
    const match = window.location.pathname.match(/\/app\/accounts\/(\d+)\//);
    const isLoginPage = window.location.pathname.includes('/app/login');
    return (match && match[1] === '1') || isLoginPage;
  }

  function applyButtonStyles() {
    if (!isTargetAccount()) return;
    
    let style = document.getElementById('ui-theme-button-style');
    if (!style) {
      style = document.createElement('style');
      style.id = 'ui-theme-button-style';
      document.head.appendChild(style);
    }
    
    style.innerHTML = `

      /* ===============================
         PRIMARY BUTTONS – LIGHT MODE
         =============================== */

      body:not(.dark) button.bg-n-blue-10.hover\\:bg-n-blue-11,
      body:not(.dark) button.bg-n-brand.text-white,
      body:not(.dark) button[data-testid="submit_button"].bg-n-brand {
        background-color: #5B3FC4 !important;
        color: #FFFFFF !important;
      }

      body:not(.dark) button.bg-n-blue-10.hover\\:bg-n-blue-11:hover,
      body:not(.dark) button.bg-n-brand.text-white:hover,
      body:not(.dark) button[data-testid="submit_button"].bg-n-brand:hover {
        background-color: #8A6CF0 !important;
        filter: none !important;
      }

      /* ===============================
         PRIMARY BUTTONS – DARK MODE
         =============================== */

      body.dark button.bg-n-blue-10.hover\\:bg-n-blue-11 {
        background-color: #5B3FC4 !important;
        color: #FFFFFF !important;
      }

      body.dark button.bg-n-blue-10.hover\\:bg-n-blue-11:hover {
        background-color: #8A6CF0 !important;
      }

      body.dark button.bg-n-brand.text-white,
      body.dark button[data-testid="submit_button"].bg-n-brand {
        background-color: #24134D !important;
        color: #C9B7FF !important;
      }

      body.dark button.bg-n-brand.text-white:hover,
      body.dark button[data-testid="submit_button"].bg-n-brand:hover {
        background-color: #36206F !important;
      }

      /* ===============================
         TAG BUTTONS – LIGHT MODE
         =============================== */

      body:not(.dark) button.bg-n-brand\\/10.text-n-blue-text {
        background-color: #EFEAFB !important;
        color: #5B3FC4 !important;
      }

      body:not(.dark) button.bg-n-brand\\/10.text-n-blue-text:hover:enabled,
      body:not(.dark) button.bg-n-brand\\/10.text-n-blue-text:focus-visible {
        background-color: #5B3FC4 !important;
        color: #FFFFFF !important;
      }

      /* ===============================
         TAG BUTTONS – DARK MODE
         =============================== */

      body.dark button.bg-n-brand\\/10.text-n-blue-text {
        background-color: #2F225A !important;
        color: #C9B7FF !important;
      }

      body.dark button.bg-n-brand\\/10.text-n-blue-text:hover:enabled,
      body.dark button.bg-n-brand\\/10.text-n-blue-text:focus-visible {
        background-color: #5B3FC4 !important;
        color: #FFFFFF !important;
      }

      /* ===============================
         BADGES – SAME FOR LIGHT/DARK
         =============================== */

      ul li div.rounded-md {
        background-color: #EFEAFB !important;
        color: #5B3FC4 !important;
      }

      ul li div.rounded-md span {
        color: #5B3FC4 !important;
      }

      a.border-n-brand div.bg-n-brand\\/10 {
        background-color: #EFEAFB !important;
        color: #5B3FC4 !important;
      }

      a.border-n-brand div.bg-n-brand\\/10 span {
        color: #5B3FC4 !important;
      }

      /* ===============================
         ASSIGN TO ME
         =============================== */

      body:not(.dark) button.text-n-blue-text.hover\\:enabled\\:underline {
        background-color: transparent !important;
        color: inherit !important;
        padding: 0 !important;
        border-radius: 0 !important;
      }

      body.dark button.text-n-blue-text.hover\\:enabled\\:underline {
        background-color: #2F225A !important;
        color: #C9B7FF !important;
        padding: 0 8px !important;
        border-radius: 9999px !important;
      }

      body.dark button.text-n-blue-text.hover\\:enabled\\:underline:hover:enabled,
      body.dark button.text-n-blue-text.hover\\:enabled\\:underline:focus-visible {
        background-color: #5B3FC4 !important;
        color: #FFFFFF !important;
      }

      /* ===============================
         TABS / MENU
         =============================== */

      a.text-n-blue-text.border-n-brand {
        color: #5B3FC4 !important;
        border-bottom-color: #5B3FC4 !important;
      }

      a.text-n-blue-text.bg-n-alpha-2.active,
      a.text-n-blue-text.bg-n-alpha-2.active .flex-1.truncate.min-w-0 {
        color: #5B3FC4 !important;
      }

      /* ===============================
         LOGIN PAGE BACKGROUND
         =============================== */

      body:not(.dark) main.bg-n-brand\\/5 {
        background-color: rgba(91, 63, 196, 0.05) !important;
      }

      /* ===============================
         LOGIN PAGE LINKS
         =============================== */

      body:not(.dark) main a.text-link {
        color: #5B3FC4 !important;
      }

      body.dark main a.text-link {
        color: #C9B7FF !important;
      }

      /* ===============================
         LOGIN PAGE H2 TITLE
         =============================== */

      body:not(.dark) h2.mt-6.text-3xl.font-medium.text-center.text-n-slate-12,
      body.dark h2.mt-6.text-3xl.font-medium.text-center.text-n-slate-12 {
        color: #000000 !important;
      }
    `;
  }

  function changeLoginTitle() {
    if (!isTargetAccount()) return;
    
    const h2 = document.querySelector('h2.mt-6.text-3xl.font-medium.text-center.text-n-slate-12');
    if (h2 && h2.textContent.trim() === 'Login to Chatwoot') {
      h2.textContent = 'Acesse sua Conta';
    }
  }

  applyButtonStyles();
  changeLoginTitle();

  const observer = new MutationObserver(function() {
    applyButtonStyles();
    changeLoginTitle();
  });
  observer.observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['class'] });
  
  // Aplicar estilos periodicamente para garantir que sejam aplicados após renderização dinâmica
  setTimeout(applyButtonStyles, 100);
  setTimeout(applyButtonStyles, 500);
  setTimeout(applyButtonStyles, 1000);
  setTimeout(changeLoginTitle, 100);
  setTimeout(changeLoginTitle, 500);
  setTimeout(changeLoginTitle, 1000);

});
</script></textarea>
        <textarea id="ocultar-aba-todos-script" style="display: none;"><script data-name="ocultar-aba-todos">
(function () {
  const MODULE_KEY = "StackLab_OcultarAbaTodos_permissions_v1";
  if (window[MODULE_KEY]) return;
  window[MODULE_KEY] = true;

  console.log("[StackLab:OcultarAba] iniciado...");

  async function fetchUserProfile() {
    try {
      const resp = await axios.get("/api/v1/profile");
      console.log("[StackLab:OcultarAba] RAW PROFILE:", resp);

      return resp?.data || null;
    } catch (e) {
      console.error("[StackLab:OcultarAba] erro ao buscar /profile", e);
      return null;
    }
  }

  function isAdminByPermissions(profile) {
    if (!profile) {
      console.log("[StackLab:OcultarAba] profile NULL → ocultar");
      return false;
    }

    const currentAccountId = profile.account_id;
    console.log("[StackLab:OcultarAba] Conta ativa:", currentAccountId);

    const accounts = profile.accounts || [];
    console.log("[StackLab:OcultarAba] Accounts:", accounts);

    const currentAcc = accounts.find(acc => acc.id === currentAccountId);

    if (!currentAcc) {
      console.warn("[StackLab:OcultarAba] Conta ativa não encontrada no array accounts → fallback ocultar");
      return false;
    }

    console.log("[StackLab:OcultarAba] Conta atual encontrada:", currentAcc);

    const perms = currentAcc.permissions || [];
    console.log("[StackLab:OcultarAba] Permissions da conta atual:", perms);

    const isAdmin = perms.includes("administrator");

    console.log("[StackLab:OcultarAba] isAdmin =", isAdmin);

    return isAdmin;
  }

  function ocultarAbaTodos() {
    const labels = ["Todos", "Todos os Contatos", "All Contacts"];

    const uls = document.querySelectorAll("ul");
    uls.forEach(ul => {
      ul.querySelectorAll("a").forEach(a => {
        const t = (a.innerText || "").trim();
        labels.forEach(lbl => {
          if (t.startsWith(lbl)) {
            const li = a.closest("li");
            if (li) {
              li.style.display = "none";
              console.log("[StackLab:OcultarAba] ocultado:", t);
            }
          }
        });
      });
    });
  }

  function startObserver(shouldHide) {
    const root = document.body;

    const obs = new MutationObserver(() => {
      if (shouldHide) ocultarAbaTodos();
    });

    obs.observe(root, { childList: true, subtree: true });
  }

  document.addEventListener("DOMContentLoaded", async () => {
    console.log("[StackLab:OcultarAba] DOM Loaded");

    const profile = await fetchUserProfile();
    const isAdmin = isAdminByPermissions(profile);

    if (!isAdmin) {
      console.log("[StackLab:OcultarAba] Não é admin → ocultando aba");
      ocultarAbaTodos();
      startObserver(true);
    } else {
      console.log("[StackLab:OcultarAba] É admin → NÃO ocultar aba");
      startObserver(false);
    }
  });
})();
</script></textarea>
        <textarea id="hide-context-delete-script" style="display: none;"><script data-name="hide-context-delete">
(function () {
  function hideDelete(root = document) {
    // procura spans ou botões com texto "Excluir"
    root.querySelectorAll('div,button,span,li').forEach(el => {
      const txt = (el.textContent || '').trim().toLowerCase();
      if (txt === 'excluir') {
        el.style.setProperty('display', 'none', 'important');
        el.setAttribute('data-hidden-ptbr', '1');
      }
    });
  }

  // primeira passada
  hideDelete();

  // observar mutações (menus abrem dinamicamente)
  const mo = new MutationObserver(() => hideDelete());
  mo.observe(document.body, { childList: true, subtree: true });

  // reforço em delays
  [100, 400, 1000].forEach(ms => setTimeout(hideDelete, ms));
})();
</script></textarea>
        <textarea id="change-logo-script" style="display: none;"><script data-name="change-logo-icon">
(function () {
  const MODULE_KEY = "StackLab_ChangeLogoIcon_v1";
  if (window[MODULE_KEY]) return;
  window[MODULE_KEY] = true;

  const LOGO_URL = "{{LOGO_URL}}";
  const USE_AS_FAVICON = {{USE_AS_FAVICON}};

  if (!LOGO_URL || LOGO_URL === "{{LOGO_URL}}") {
    return;
  }

  function changeLogo(root = document) {
    // Procura imagens com src="/brand-assets/logo_thumbnail.svg" ou classe size-4
    root.querySelectorAll('img').forEach(img => {
      const src = img.getAttribute('src') || '';
      const hasClass = img.classList.contains('size-4');
      
      if (src.includes('/brand-assets/logo_thumbnail.svg') || 
          (hasClass && src.includes('logo_thumbnail'))) {
        img.setAttribute('src', LOGO_URL);
        img.setAttribute('data-logo-icon-changed', '1');
      }
    });
  }

  function changeFavicon() {
    if (!USE_AS_FAVICON) return;
    
    // Procura todos os links de favicon
    document.querySelectorAll('link[rel="icon"], link.favicon').forEach(link => {
      link.setAttribute('href', LOGO_URL);
      link.setAttribute('data-favicon-changed', '1');
    });
    
    // Também cria um novo link se não existir
    if (!document.querySelector('link[rel="icon"][data-favicon-changed="1"]')) {
      const link = document.createElement('link');
      link.setAttribute('rel', 'icon');
      link.setAttribute('href', LOGO_URL);
      link.setAttribute('data-favicon-changed', '1');
      document.head.appendChild(link);
    }
  }

  // primeira passada
  changeLogo();
  changeFavicon();

  // observar mutações (elementos podem ser adicionados dinamicamente)
  const mo = new MutationObserver(() => {
    changeLogo();
    changeFavicon();
  });
  mo.observe(document.body, { childList: true, subtree: true });
  mo.observe(document.head, { childList: true, subtree: true });

  // reforço em delays
  [100, 400, 1000].forEach(ms => {
    setTimeout(() => {
      changeLogo();
      changeFavicon();
    }, ms);
  });
})();
</script></textarea>
