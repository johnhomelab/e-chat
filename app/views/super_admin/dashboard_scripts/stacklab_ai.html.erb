<% content_for(:title) do %>
  StackLab AI - Dashboard Scripts
<% end %>

<style>
.stacklab-header {
  background: #000000;
  color: white;
  padding: 2rem;
  border-radius: 12px;
  margin-bottom: 2rem;
  text-align: center;
}

.stacklab-content {
  background: white;
  border-radius: 12px;
  padding: 2rem;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
}

.ai-icon {
  font-size: 4rem;
  margin-bottom: 1rem;
  opacity: 0.9;
  text-align: center;
}

.ai-icon svg {
  display: block;
  margin: 0 auto;
}

/* Syntax Highlighting para HTML */
.syntax-highlight {
  font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
  font-size: 14px;
  line-height: 1.4;
  white-space: pre-wrap;
  word-wrap: break-word;
}

.syntax-highlight .tag {
  color: #22863a;
  font-weight: bold;
}

.syntax-highlight .attr {
  color: #6f42c1;
}

.syntax-highlight .attr-value {
  color: #032f62;
}

.syntax-highlight .comment {
  color: #6a737d;
  font-style: italic;
}

.syntax-highlight .text {
  color: #24292e;
}

.syntax-highlight .doctype {
  color: #6f42c1;
  font-weight: bold;
}

/* Syntax Highlighting para JavaScript */
.syntax-highlight .keyword {
  color: #d73a49;
  font-weight: bold;
}

.syntax-highlight .string {
  color: #032f62;
}

.syntax-highlight .number {
  color: #005cc5;
}

.syntax-highlight .function {
  color: #6f42c1;
}

.syntax-highlight .comment {
  color: #6a737d;
  font-style: italic;
}
</style>

<header class="main-content__header" role="banner">
  <div class="flex justify-between items-center w-full">
    <h1 class="main-content__page-title" id="page-title">
      <%= content_for(:title) %>
    </h1>
    <div class="flex items-center ml-auto">
      <button onclick="window.history.back()" class="flex items-center space-x-2 text-gray-600 hover:text-gray-800 transition-colors px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        <span class="text-sm font-medium">Voltar</span>
      </button>
    </div>
  </div>
</header>

<section class="main-content__body">
  <div class="stacklab-header">
    <div class="ai-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-circle-code-icon lucide-message-circle-code"><path d="m10 9-3 3 3 3"/><path d="m14 15 3-3-3-3"/><path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719"/></svg>
    </div>
    <h1 class="text-3xl font-bold mb-2">StackLab AI</h1>
    <p class="text-lg opacity-90">Inteligência Artificial para criação de scripts personalizados</p>
  </div>

  <div class="stacklab-content">
    <div class="max-w-2xl mx-auto">
      <div class="mb-6">
        <label for="ai-message" class="block text-sm font-medium text-gray-700 mb-2">
          Descreva o script que você precisa:
        </label>
        <textarea
          id="ai-message"
          name="ai-message"
          rows="4"
          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 resize-none"
          placeholder="Ex: Criar um script para enviar notificações automáticas quando um ticket fica sem resposta por mais de 24 horas..."
        ></textarea>
      </div>

      <div class="flex justify-center">
        <button
          type="button"
          id="generate-script-btn"
          class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
            <path d="m10 9-3 3 3 3"/>
            <path d="m14 15 3-3-3-3"/>
            <path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719"/>
          </svg>
          <span id="btn-text">Gerar Script</span>
        </button>
      </div>

      <!-- Resultado do Script Gerado -->
      <div id="script-result" class="mt-8 hidden">
        <div class="bg-white border border-gray-200 rounded-lg p-4">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-gray-800 flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22,4 12,14.01 9,11.01"/>
              </svg>
              Script Gerado com Sucesso!
            </h3>
            <button
              id="copy-script-btn"
              class="inline-flex items-center px-3 py-1 border border-gray-300 rounded-md text-sm bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1">
                <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                <path d="m4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
              </svg>
              Copiar Código
            </button>
          </div>

          <div class="bg-gray-100 rounded-lg p-4 overflow-x-auto border">
            <pre id="script-code" class="syntax-highlight whitespace-pre-wrap break-words"></pre>
          </div>

          <div class="mt-4 text-sm text-gray-600">
            <p>💡 <strong>Dica:</strong> Clique no botão "Copiar Código" acima para copiar todo o script gerado.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const generateBtn = document.getElementById('generate-script-btn');
  const btnText = document.getElementById('btn-text');
  const textarea = document.getElementById('ai-message');
  const scriptResult = document.getElementById('script-result');
  const scriptCode = document.getElementById('script-code');
  const copyScriptBtn = document.getElementById('copy-script-btn');

  // Função para aplicar syntax highlighting
  function applySyntaxHighlighting(code) {
    // Remove markdown code blocks se existirem
    code = code.replace(/^```(?:javascript|html|js)?\s*/, '').replace(/\s*```$/, '');

    // Detectar tipo de código
    const isHTML = /<\/?[a-zA-Z][^>]*>/.test(code) || code.includes('<script') || code.includes('<div') || code.includes('<button');

    if (isHTML) {
      return highlightHTML(code);
    } else {
      return highlightJavaScript(code);
    }
  }

  // Syntax highlighting para HTML
  function highlightHTML(code) {
    let highlighted = code;

    // Escapar caracteres especiais primeiro
    highlighted = highlighted.replace(/&/g, '&amp;');
    highlighted = highlighted.replace(/</g, '&lt;');
    highlighted = highlighted.replace(/>/g, '&gt;');

    // Aplicar highlighting básico e simples
    highlighted = highlighted
      .replace(/(&lt;!--[\s\S]*?--&gt;)/g, '<span class="comment">$1</span>')
      .replace(/(&lt;!DOCTYPE[^&]*&gt;)/gi, '<span class="doctype">$1</span>')
      .replace(/(&lt;\/?(script|div|button|span|style|html|head|body|title|meta|link|input|form|p|h1|h2|h3|h4|h5|h6|ul|ol|li|a|img|table|tr|td|th|thead|tbody)[^&]*&gt;)/gi, function(match) {
        return match.replace(/(&lt;\/?)([a-zA-Z][a-zA-Z0-9]*)/, '$1<span class="tag">$2</span>');
      });

    return highlighted;
  }

  // Syntax highlighting para JavaScript
  function highlightJavaScript(code) {
    return code
      .replace(/(\/\/.*$)/gm, '<span class="comment">$1</span>')
      .replace(/(\/\*[\s\S]*?\*\/)/g, '<span class="comment">$1</span>')
      .replace(/(["'])(.*?)\1/g, '<span class="string">$1$2$1</span>')
      .replace(/\b(function|var|let|const|if|else|for|while|do|return|try|catch|finally|throw|new|this|class|extends|import|export|default|async|await|yield)\b/g, '<span class="keyword">$1</span>')
      .replace(/\b\d+(\.\d+)?\b/g, '<span class="number">$1</span>')
      .replace(/\b([a-zA-Z_$][a-zA-Z0-9_$]*)\s*\(/g, '<span class="function">$1</span>(');
  }

  // Função para formatar código com indentação
  function formatCode(code) {
    let formatted = code;
    let indentLevel = 0;
    const indentSize = 2;

    formatted = formatted.split('\n').map(line => {
      const trimmed = line.trim();
      if (!trimmed) return '';

      // Diminuir indentação para linhas que fecham blocos
      if (trimmed.startsWith('}') || trimmed.startsWith(']') || trimmed.startsWith(')')) {
        indentLevel = Math.max(0, indentLevel - 1);
      }

      const indented = ' '.repeat(indentLevel * indentSize) + trimmed;

      // Aumentar indentação para linhas que abrem blocos
      if (trimmed.endsWith('{') || trimmed.endsWith('[') || trimmed.endsWith('(') ||
          trimmed.includes('function') || trimmed.includes('if') || trimmed.includes('for') ||
          trimmed.includes('while') || trimmed.includes('do')) {
        indentLevel++;
      }

      return indented;
    }).join('\n');

    return formatted;
  }

  // Função para copiar código
  async function copyToClipboard(text) {
    try {
      await navigator.clipboard.writeText(text);
      // Feedback visual
      const originalText = copyScriptBtn.innerHTML;
      copyScriptBtn.innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1">
          <polyline points="20,6 9,17 4,12"/>
        </svg>
        Copiado!
      `;
      copyScriptBtn.classList.add('bg-green-100', 'text-green-800', 'border-green-300');

      setTimeout(() => {
        copyScriptBtn.innerHTML = originalText;
        copyScriptBtn.classList.remove('bg-green-100', 'text-green-800', 'border-green-300');
      }, 2000);
    } catch (error) {
      console.error('Erro ao copiar:', error);
      alert('Erro ao copiar para a área de transferência');
    }
  }

  generateBtn.addEventListener('click', async function() {
    const prompt = textarea.value.trim();

    if (!prompt) {
      alert('Por favor, descreva o script que você precisa.');
      textarea.focus();
      return;
    }

    // Desabilitar botão e mostrar loading
    generateBtn.disabled = true;
    btnText.textContent = 'Gerando...';
    scriptResult.classList.add('hidden');

    try {
      const response = await fetch('/super_admin/dashboard_scripts/generate_script', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
        },
        body: JSON.stringify({ prompt: prompt })
      });

      const data = await response.json();

      if (response.ok) {
        // Sucesso - mostrar resultado
        if (data.success && data.script) {
          const formattedCode = formatCode(data.script);
          const highlightedCode = applySyntaxHighlighting(formattedCode);
          scriptCode.innerHTML = highlightedCode;
          scriptResult.classList.remove('hidden');

          // Scroll para o resultado
          scriptResult.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } else {
          alert('Erro: Resposta inválida da API');
        }
      } else {
        // Erro
        alert('Erro: ' + (data.error || 'Erro desconhecido'));
      }
    } catch (error) {
      console.error('Erro:', error);
      alert('Erro ao conectar com o servidor. Tente novamente.');
    } finally {
      // Reabilitar botão
      generateBtn.disabled = false;
      btnText.textContent = 'Gerar Script';
    }
  });

  // Event listener para o botão de copiar
  copyScriptBtn.addEventListener('click', function() {
    const code = scriptCode.textContent || scriptCode.innerText;
    if (code) {
      copyToClipboard(code);
    }
  });
});
</script>
